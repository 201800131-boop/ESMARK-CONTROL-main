{
  "name": "@esmark/windows",
  "version": "1.0.32",
  "description": "ESMARK Control desktop app",
  "author": "ESMARK",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder --publish never",
    "electron:build:signed": "npm run build && electron-builder --publish never -c.win.signAndEditExecutable=true",
    "electron:publish": "npm run build && electron-builder --publish always -c.win.signAndEditExecutable=true",
    "release:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/release-github.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "electron-updater": "^6.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "30.5.1",
    "electron-builder": "^24.13.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.esmark.control",
    "productName": "ESMARK Control",
    "executableName": "ESMARK Control",
    "copyright": "Copyright 2026 ESMARK",
    "icon": "public/app-icon.ico",
    "artifactName": "ESMARK-Control-Setup-${version}.${ext}",
    "compression": "normal",
    "afterPack": "scripts/after-pack-windows.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "public/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/app-icon.ico",
      "publisherName": "ESMARK",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": false,
      "perMachine": false,
      "installerIcon": "public/app-icon.ico",
      "uninstallerIcon": "public/app-icon.ico",
      "installerHeaderIcon": "public/app-icon.ico",
      "installerSidebar": "public/app-icon.ico",
      "installerHeader": "public/app-icon.ico",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ESMARK Control"
    },
    "publish": {
      "provider": "github",
      "owner": "201800131-boop",
      "repo": "ESMARK-CONTROL-main",
      "releaseType": "release"
    }
  }
}

